SECRET_KEY=troque-isto
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS=http://localhost:5173

# OpenAI — leitura de documentos do cliente por IA (opcional).
# Sem a chave, o botão de leitura responde 503 e o preenchimento manual segue normal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini            # comprovantes de residência
OPENAI_MODEL_IDENTIDADE=gpt-4o      # RG/CNH — o mini erra nesses documentos

# uazapi — código de acesso do cliente por WhatsApp (área "Sou cliente" do app).
# Sem estas variáveis o login por WhatsApp responde 503 e o acesso alternativo
# (e-mail/senha) continua funcionando.
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
APP_CLIENTE_NOME=FlowALR
# WhatsApp do escritório que recebe o aviso de novo pré-cadastro (só dígitos com DDI)
ESCRITORIO_WHATSAPP=

# ZapSign (assinatura eletrônica)
ZAPSIGN_API_TOKEN=
# Origem pública deste backend, sem barra final. Usada para montar o link do
# portal de assinatura entregue ao cliente. Em produção é obrigatória; em
# desenvolvimento, se vazia, o link é derivado do request.
PUBLIC_BASE_URL=

# Google Places API (autocomplete de endereço). Use a mesma chave do front.
# GOOGLE_MAPS_PLACES_REFERER deve ser uma origem permitida na restrição de
# referrer da chave (o backend a envia como header Referer para a chave passar em produção).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PLACES_REFERER=http://localhost:3000

# Banco: use localhost para Django na máquina; 172.17.0.1 se Django rodar dentro do Docker
DB_NAME=jurisdoc
DB_USER=jurisdoc_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
